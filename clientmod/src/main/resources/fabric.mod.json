{
    "schemaVersion": 1,
    "id": "minecraftchallenges",
    "version": "${version}",
    "name": "MinecraftChallenges",
    "description": "Plays the MinecraftChallenges Jump & Run music, including C418's songs, fades it out at the end of a run and keeps the background music away while it plays.",
    "authors": ["ItzKatze"],
    "license": "GPL-3.0",
    "environment": "client",
    "entrypoints": {
        "client": ["gg.itzkatze.mcc.client.MinecraftChallengesClient"]
    },
    "mixins": ["minecraftchallenges.mixins.json"],
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}"
    }
}
